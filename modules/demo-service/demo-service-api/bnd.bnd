Bundle-Name: demo-service-api
Bundle-SymbolicName: cms.demo.api
Bundle-Version: 1.0.0
Export-Package:\
	cms.demo.exception,\
	cms.demo.model,\
	cms.demo.service,\
	cms.demo.service.persistence
-check: EXPORTS
-consumer-policy: ${replacestring;${range;[==,==]};.*,(.*)];$1}
-includeresource: META-INF/service.xml=../demo-service-service/service.xml
-provider-policy: ${replacestring;${range;[==,==]};.*,(.*)];$1}